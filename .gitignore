# Task/state files (personal — never committed)
TODO.md
NOW.md

# Internal research notes (not part of the public artifact)
knowledge/

# Reviewer/ARR text — never committed (owner policy)
text_docs/reviews/
# Submission packaging: manifests and upload sets. Gitignored because a
# committed directory named for a venue, holding submission machinery, is
# the exact pairing `tests/test_public_repo_hygiene.py` forbids in prose —
# and the rule is about the pairing, not about where it is written.
text_docs/submission/

# Third-party reference implementations, cloned for reading (family standard —
# same as the guardrail sibling). Never vendored into src/: the oikos rule is
# consume infrastructure as a pinned dependency, and third-party research code
# is read here, cited, and reimplemented under our own controls.
other_repos/

# Experiment artifacts
outputs/
data/
logs/
# Cluster ops layer (family standard: committed code travels by git, the ops
# layer by rsync). Gitignored because it encodes one site's paths and account
# layout, which is not public-repo content.
ops/

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store

# Secret-injection bootstrap — never committed in a public repo (global law):
# the launcher and its pointer map name the vault layout, which is private even
# though neither file holds a secret value.
/run
scripts/op_refs

# Secrets (defense-in-depth)
.env
.env.*
*.env
# ...except the placeholder contract, which is the point of a public repo:
# it names the variables to set and holds no values.
!.env.example
keys/
secrets/
*.key
*.pem
*credentials*
*.secret

# LaTeX aux junk (keep deliverable PDFs)
*.aux
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls
*.toc

# task-estate store + operational state (personal data — never committed; task-estate refactor 2026-08-04)
/state/

# LaTeX paper sources — local only, matching the guardrail sibling.
# This repo is PUBLIC: paper dirs accumulate reviewer text, venue style files
# under their own licenses, build artifacts and PDFs. Ignoring the whole tree
# keeps that out by construction rather than by remembering. Anything from a
# paper that should be public belongs in text_docs/. See paper/README.md.
paper/
