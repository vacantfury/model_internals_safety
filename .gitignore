# Cluster ops layer (family standard: committed code travels by git, the ops
# layer by rsync). Gitignored because it encodes one site's paths and account
# layout, which is not public-repo content.
ops/

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store

# Secret-injection bootstrap — never committed in a public repo (global law):
# the launcher and its pointer map name the vault layout, which is private even
# though neither file holds a secret value.
/run
scripts/op_refs

# Secrets (defense-in-depth)
.env
.env.*
*.env
# ...except the placeholder contract, which is the point of a public repo:
# it names the variables to set and holds no values.
!.env.example
keys/
secrets/
*.key
*.pem
*credentials*
*.secret

